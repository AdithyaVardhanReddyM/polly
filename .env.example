# Copy to .env in the repo root and fill in your keys:
#   cp .env.example .env
# .env is gitignored. Real environment variables always win over this file.

# ---------------------------------------------------------------------------
# Models — Nebius Token Factory (https://tokenfactory.nebius.com)
# ---------------------------------------------------------------------------
NEBIUS_API_KEY=
# Default: https://api.tokenfactory.nebius.com/v1/
# NEBIUS_BASE_URL=

# Model ids are case-sensitive. Run `npm run check` to list what your key can use.
# POLLY_MODEL=nvidia/nemotron-3-super-120b-a12b
# POLLY_FAST_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# ---------------------------------------------------------------------------
# Sandboxes and agent computers — Nebius ConTree
# ---------------------------------------------------------------------------
# Install the extra first: cd server && uv sync --extra sandbox
# POLLY_SANDBOX=contree
NEBIUS_PROJECT_ID=

# ---------------------------------------------------------------------------
# Web search — Tavily (https://tavily.com)
# ---------------------------------------------------------------------------
TAVILY_API_KEY=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# POLLY_HOST=127.0.0.1
# POLLY_PORT=8787
# Where agent memory, threads and workspaces live. Default: <repo>/.polly
# POLLY_DATA_DIR=
