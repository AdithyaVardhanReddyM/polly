# Copy to .env in the repo root and fill in your keys:
#   cp .env.example .env
# .env is gitignored. Real environment variables always win over this file.

# ---------------------------------------------------------------------------
# Models — Nebius Token Factory (https://tokenfactory.nebius.com)
# ---------------------------------------------------------------------------
NEBIUS_API_KEY=
# Default: https://api.tokenfactory.nebius.com/v1/
# NEBIUS_BASE_URL=

# Model ids are case-sensitive. Run `npm run check` to list what your key can use.
# POLLY_MODEL=nvidia/nemotron-3-super-120b-a12b
# POLLY_FAST_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# Heavy reasoning: scoring pull requests and critiquing Deep Research drafts.
# POLLY_STRONG_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
# Vision: the Designer's critic looks at a screenshot of each finished design.
# POLLY_VISION_MODEL=zai-org/GLM-5.3-Flash

# ---------------------------------------------------------------------------
# Sandboxes and agent computers — Nebius ConTree
# ---------------------------------------------------------------------------
# Install the extra first: cd server && uv sync --extra sandbox
# POLLY_SANDBOX=contree
NEBIUS_PROJECT_ID=

# ---------------------------------------------------------------------------
# Web search — Tavily (https://tavily.com)
# Needed by the Researcher, Deep Research and change research. The Reviewer
# works without it (it just skips looking things up on the web).
# ---------------------------------------------------------------------------
TAVILY_API_KEY=

# ---------------------------------------------------------------------------
# GitHub — reading pull requests for the Reviewer, posting its score
# ---------------------------------------------------------------------------
# Public PRs work with neither. Pick one:
# 1. Sign in from the app (Integrations > GitHub). Create an OAuth App at
#    https://github.com/settings/developers, tick "Enable Device Flow", and
#    paste its Client ID here. No client secret is needed.
GITHUB_CLIENT_ID=
# 2. Or a personal access token (Pull requests: read, plus write to post).
#    You can also paste one in the app instead of setting it here.
# GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# POLLY_HOST=127.0.0.1
# POLLY_PORT=8787
# Where agent memory, threads and workspaces live. Default: <repo>/.polly
# POLLY_DATA_DIR=
